<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="411dp"
        android:layout_height="67dp"
        android:background="#C2BBB9"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/avatarToolbar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:scaleType="centerCrop"
                android:src="@drawable/imagen_usuario" />

            <TextView
                android:id="@+id/nombreUsuario"
                android:layout_width="271dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:text="Usuario"
                android:textColor="#000000"
                android:textSize="30sp"
                android:textStyle="bold" />
        </LinearLayout>

    </androidx.appcompat.widget.Toolbar>


    <TextView
        android:id="@+id/textTitulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Introduce los datos de la nueva canción"
        android:textSize="18sp"
        android:textStyle="bold"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/editArtista"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Artista"
        android:inputType="textPersonName"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/textTitulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/editCancion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Canción"
        android:inputType="text"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/editArtista"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/editDuracion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Duración (mm:ss)"
        android:inputType="text"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/editCancion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/editValoracion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Valoración"
        android:inputType="number"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/editDuracion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/editReproducciones"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Reproducciones"
        android:inputType="number"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/editValoracion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/botonAnadir"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Añadir"
        android:layout_margin="16dp"
        app:layout_constraintTop_toBottomOf="@id/editReproducciones"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textEstado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#B00020"
        android:visibility="visible"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/botonAnadir"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>




</androidx.constraintlayout.widget.ConstraintLayout>